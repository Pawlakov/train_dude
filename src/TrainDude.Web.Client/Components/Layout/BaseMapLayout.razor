@inherits LayoutComponentBase

<div id="map"></div>
<div class="cs-content-wrapper">
    <ErrorBoundary>
        <ChildContent>
            @this.Body
        </ChildContent>
        <ErrorContent Context="exception">
            <div class="container-fluid">
                <main class="container rounded shadow bg-body">
                    @exception.GetType().Name
                </main>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</div>