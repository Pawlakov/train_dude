@page "/segment/{Id:guid}"
@using TrainDude.Features.Segments.Contracts.GetSegment
@using TrainDude.Features.Segments.Contracts.GetSegmentMap
@inherits MapEntityLookupPageBase<GetSegmentQuery, GetSegmentQueryResult, GetSegmentMapQuery>

@code {
    protected override GetSegmentQuery BuildQuery(EntityLookupFormModel formModel)
    {
        return new GetSegmentQuery(formModel.Id);
    }

    protected override GetSegmentMapQuery BuildMapQuery(EntityLookupFormModel formModel)
    {
        return new GetSegmentMapQuery(formModel.Id);
    }
}

<PageTitle>Odcinek</PageTitle>

<Breadcrumb>
    <BreadcrumbItem Active="false" IconClass="list" Label="Odcinki" Href="/segments"/>
    <BreadcrumbItem Active="true" IconClass="route" Label="Odcinek" Href="@("/segment/" + this.Id)"/>
</Breadcrumb>
<h1 tabindex="-1">Odcinek</h1>
@if (this.queryResult != null)
{
    <p class="lead">@(this.queryResult.AName) - @(this.queryResult.BName)</p>
}
<hr/>
@if (this.queryResult == null)
{
    <EditForm EditContext="this.formContext" OnValidSubmit="this.Submit" FormName="GetSegmentForm">
        <FluentValidationValidator @ref="this.validator" TModel="GetSegmentQuery"/>
        <section class="section">
            <div class="field">
                <label class="label">ID</label>
                <TemplatedValidationMessage For="() => this.formModel.Id" BaseClass="input">
                    <InputTemplate Context="inputClasses">
                        <input class="@(inputClasses)" value="@(this.formModel.Id)" disabled/>
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
        </section>
    </EditForm>
}
else
{
    <div class="row text-center">
        <div class="col-3 align-self-center">
            <a href="/station/@(this.queryResult.AId)">@(this.queryResult.AName)</a>
        </div>
        <div class="col align-self-center">
            <LengthDisplay Haversine="this.queryResult.Haversine" Length="this.queryResult.NominalLength"/>
            <hr/>
            <span>tory: @(this.queryResult.Tracks)</span>
        </div>
        <div class="col-3 align-self-center">
            <a href="/station/@(this.queryResult.BId)">@(this.queryResult.BName)</a>
        </div>
    </div>
    <hr/>
    @foreach (var item in this.queryResult.Trips)
    {
        <div class="row text-center">
            <div class="col-3 align-self-center">
                12:00
            </div>
            <div class="col align-self-center">
                <a href="/trips/@(item.TripId)">@(item.Number)</a>
            </div>
            <div class="col-3 align-self-center">
                12:00
            </div>
        </div>
    }
}