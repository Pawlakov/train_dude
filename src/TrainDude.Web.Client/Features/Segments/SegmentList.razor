@page "/segments"
@inherits EntityListPageBase<TrainDude.Features.Segments.Contracts.GetSegments.GetSegmentsQuery, TrainDude.Features.Segments.Contracts.GetSegments.GetSegmentsQueryResult, TrainDude.Features.Segments.Contracts.GetSegments.GetSegmentsQueryResultItem>
@layout BlockMapLayout

<PageTitle>Odcinki</PageTitle>

<Breadcrumb>
    <BreadcrumbItem Active="true" IconClass="list" Label="Odcinki" Href="/segments"/>
</Breadcrumb>
<section class="section">
    <h1 class="title">Odcinki</h1>
    <p class="subtitle">Lista odcinków.</p>
</section>
<hr/>
<section class="section">
    <div class="table-container">
        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>A</th>
                <th>B</th>
                <th>Długość</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (this.items == null)
            {
                <tr>
                    <td colspan="4"><em>Ładowanie...</em></td>
                </tr>
            }
            else
            {
                @foreach (var segment in this.items)
                {
                    <tr>
                        <td><a href="station/@(segment.A.Id)">@(segment.A.Name)</a></td>
                        <td><a href="station/@(segment.B.Id)">@(segment.B.Name)</a></td>
                        <td><LengthDisplay Haversine="segment.Haversine" Length="segment.Length"/></td>
                        <td><a href="segment/@(segment.SegmentId)">Szczegóły</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>