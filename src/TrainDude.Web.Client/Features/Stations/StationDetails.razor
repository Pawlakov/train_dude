@page "/station/{Id:guid}"
@using TrainDude.Features.Stations.Contracts.GetStation
@using TrainDude.Features.Stations.Contracts.GetStationMap
@using TrainDude.Web.Client.Features.Shared
@inherits MapEntityLookupPageBase<GetStationQuery, GetStationQueryResult, GetStationMapQuery>

@if (this.queryResult != null)
{
    <PageTitle>Stacja @(this.queryResult.Name)</PageTitle>
}
else
{
    <PageTitle>Stacja</PageTitle>
}

<Breadcrumb>
    <BreadcrumbItem Active="false" IconClass="list" Label="Stacje" Href="/stations"/>
    <BreadcrumbItem Active="true" IconClass="shop" Label="Stacja" Href="@("/station/" + this.Id)"/>
</Breadcrumb>
<section class="section">
    <h1 class="title">Stacja</h1>
    @if (this.queryResult != null)
    {
        <p class="subtitle">@(this.queryResult.Name)</p>
    }
</section>
<hr/>
@if (this.queryResult == null)
{
    <EditForm EditContext="this.formContext" OnValidSubmit="this.Submit" FormName="GetStationForm">
        <FluentValidationValidator @ref="this.validator" TModel="EntityLookupFormModel"/>
        <section class="section">
            <div class="field">
                <label class="label">ID</label>
                <TemplatedValidationMessage For="() => this.formModel.Id" BaseClass="input">
                    <InputTemplate Context="inputClasses">
                        <input class="@(inputClasses)" value="@(this.formModel.Id)" disabled/>
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
        </section>
    </EditForm>
}
else
{
    <section class="section">

    </section>
}

@code {

    protected override GetStationQuery BuildQuery(EntityLookupFormModel formModel)
    {
        return new GetStationQuery();
    }

    protected override GetStationMapQuery BuildMapQuery(EntityLookupFormModel formModel)
    {
        return new GetStationMapQuery();
    }

}