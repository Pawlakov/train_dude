@page "/trip/{Id:guid}"
@using TrainDude.Features.Trips.Contracts.GetTrip
@using TrainDude.Features.Trips.Contracts.GetTripMap
@inherits MapEntityLookupPageBase<GetTripQuery, GetTripQueryResult, GetTripMapQuery>

@code {

    protected override GetTripQuery BuildQuery(EntityLookupFormModel formModel)
    {
        return new GetTripQuery();
    }

    protected override GetTripMapQuery BuildMapQuery(EntityLookupFormModel formModel)
    {
        return new GetTripMapQuery();
    }
}

@if (this.queryResult != null)
{
    <PageTitle>Kurs @(this.queryResult.TripNumber)</PageTitle>
}
else
{
    <PageTitle>Kurs</PageTitle>
}

<Breadcrumb>
    <BreadcrumbItem Active="false" IconClass="list" Label="Kursy" Href="/trips"/>
    <BreadcrumbItem Active="true" IconClass="train" Label="Kurs" Href="@("/trip/" + this.Id)"/>
</Breadcrumb>
<section class="section">
    <h1 class="title">Kurs</h1>
    @if (this.queryResult != null)
    {
        <p class="subtitle">@(this.queryResult.TripNumber)</p>
    }
</section>
<hr/>
@if (this.queryResult == null)
{
    <EditForm EditContext="this.formContext" OnValidSubmit="this.Submit" FormName="GetTripForm">
        <FluentValidationValidator @ref="this.validator" TModel="EntityLookupFormModel"/>
        <section class="section">
            <div class="field">
                <label class="label">ID</label>
                <TemplatedValidationMessage For="() => this.formModel.Id" BaseClass="input">
                    <InputTemplate Context="inputClasses">
                        <input class="@(inputClasses)" value="@(this.formModel.Id)" disabled/>
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
        </section>
    </EditForm>
}
else
{
    <section class="section">

    </section>
}