@using FluentValidation
@using TrainDude.Features.Settings.Contracts.GetNamingPolicy
@using TrainDude.Features.Settings.Contracts.SetNamingPolicy
@using TrainDude.Features.Shared.Contracts.Enums
@using TrainDude.Features.Shared.Contracts.Generic

@inject ApiClient Api

@if (this.editActive)
{
    <EditForm EditContext="this.formContext" OnValidSubmit="this.Submit" FormName="UpdateStationNameModeForm">
        <FluentValidationValidator @ref="this.validator" TModel="SettingsFormModel"/>
        <p class="title is-6">
            Nazwy stacji
            <a class="icon" @onclick="this.Submit">
                <i class="fas fa-check"></i>
            </a>
            <a class="icon" @onclick="this.DeactivateEdit">
                <i class="fas fa-x"></i>
            </a>
        </p>
        <TemplatedValidationMessage For="() => this.formModel.Policy" BaseClass="radios"
                                    ControlClass="subtitle is-6">
            <InputTemplate Context="inputClasses">
                <div>
                    <InputRadioGroup @bind-Value="this.formModel.Policy">
                        <label class="radio">
                            <InputRadio value="@(NamingPolicy.Modern)"/>
                            Współczesne
                        </label>
                        <label class="radio">
                            <InputRadio value="@(NamingPolicy.German)"/>
                            Niemieckie
                        </label>
                    </InputRadioGroup>
                </div>
            </InputTemplate>
        </TemplatedValidationMessage>
    </EditForm>
}
else
{
    <p class="title is-6">
        Nazwy stacji
        <a class="icon" @onclick="this.ActivateEdit">
            <i class="fas fa-pencil"></i>
        </a>
    </p>
    <p class="subtitle is-6">
        @if (this.queryResult != null)
        {
            if (this.queryResult.Policy == NamingPolicy.Modern)
            {
                <text>Współczesne</text>
            }
            else
            {
                <text>Niemieckie</text>
            }
        }
        else
        {
            <text>Ładowanie...</text>
        }
    </p>
}

@code {
    private bool editActive;
    private GetNamingPolicyResult? queryResult;
    private SettingsFormModel? formModel;
    private EditContext? formContext;
    private FluentValidationValidator<SettingsFormModel>? validator;

    protected override async Task OnInitializedAsync()
    {
        await this.Refresh();
    }

    private Task ActivateEdit()
    {
        this.editActive = true;
        this.formContext = new EditContext(this.formModel);
        return Task.CompletedTask;
    }

    private Task DeactivateEdit()
    {
        this.editActive = false;
        this.formContext = null;
        return Task.CompletedTask;
    }

    private async Task Refresh()
    {
        var query = new GetNamingPolicyQuery();
        this.queryResult = await this.Api.GetAsync<GetNamingPolicyQuery, GetNamingPolicyResult>(query);
        this.formModel = new SettingsFormModel() { Policy = this.queryResult.Policy };
    }

    private async Task Submit()
    {
        var valid = this.formContext.Validate();
        if (valid)
        {
            try
            {
                var command = new SetNamingPolicyCommand(this.formModel.Policy);
                await this.Api.PostAsync<SetNamingPolicyCommand>(command);
                await this.DeactivateEdit();
            }
            catch (ValidationException exception)
            {
                this.validator.PopulateErrors(exception.Errors);
            }
        }
    }
}