@using TrainDude.Network.DTOs;
@using TrainDude.Network.Queries;

@page "/segment/{Id:int}"

@inject NavigationManager NavigationManager
@inject IMediator Mediator
@inject IJSRuntime JS

<PageTitle>Odcinek</PageTitle>

<section class="section">
    <h1 class="title">Odcinek</h1>
    @if (this.segment != null)
    {
        <p class="subtitle">@(this.segment.AName) - @(this.segment.BName)</p>
    }
</section>
<hr />
<section class="section">
    <div class="block">
        <div id="map" style="height:512px;"></div>
    </div>
</section>

@code {
    private IJSObjectReference scriptModule;
    private SegmentDetailsDTO? segment;
    private string segmentGeoJson;
    private string antiradiusSeries;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        this.segment = await this.Mediator.Send(new GetSegmentQuery(this.Id));
        if (this.segment != null)
        {
            this.segmentGeoJson = await this.Mediator.Send(new GetSegmentGeoJsonQuery(this.Id));
            /* TODO this thing:
            this.antiradiusSeries = await this.Mediator.Send(new GetSegmentAntiradiusSeriesQuery(this.Id, 20));*/
        }
        else
        {
            NavigationManager.NotFound();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (this.segment != null && firstRender)
        {
            this.scriptModule = await this.JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Segment.razor.js");

            await this.scriptModule.InvokeVoidAsync("initMap", "map", segment.ALocation!.Latitude, segment.ALocation!.Longitude, 12);
            await this.scriptModule.InvokeVoidAsync("addGeoJson", this.segmentGeoJson);
        }
    }
}
