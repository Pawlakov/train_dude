<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li>
            <a href="/">
                <span class="icon is-small">
                    <i class="fas fa-map" aria-hidden="true"></i>
                </span>
                <span>Mapa</span>
            </a>
        </li>
        @foreach (var item in this.Items.Prepend(new BreadcrumbItem("/", "map", "Mapa")))
        {
            <li class="@(item == this.Items.Last() ? "is-active" : null)">
                <a href="@(item.Href)">
                    <span class="icon is-small">
                        <i class="fas fa-@(item.IconClass)" aria-hidden="true"></i>
                    </span>
                    <span>@(item.Label)</span>
                </a>
            </li>
        }
    </ul>
</nav>

@code {
    [Parameter]
    public IEnumerable<BreadcrumbItem> Items { get; set; } = [];
}