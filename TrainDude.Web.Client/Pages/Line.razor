@page "/line/{LineId:guid}"
@using FluentValidation
@using Mediator
@using TrainDude.Queries.Requests.GetLineQuery
@using TrainDude.Web.Client.Validation
@inject ISender Mediator

@if (this.queryResult != null)
{
    <PageTitle>Linia @(this.queryResult.LineDesignation)</PageTitle>
}
else
{
    <PageTitle>Linia</PageTitle>
}

<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li>
            <a href="/">
                <span class="icon is-small">
                    <i class="fas fa-map" aria-hidden="true"></i>
                </span>
                <span>Mapa</span>
            </a>
        </li>
        <li>
            <a href="/lines">
                <span class="icon is-small">
                    <i class="fas fa-list" aria-hidden="true"></i>
                </span>
                <span>Linie</span>
            </a>
        </li>
        @if (this.queryResult != null)
        {
            <li class="is-active">
                <a href="/line/@(this.LineId)">
                    <span class="icon is-small">
                        <i class="fas fa-route" aria-hidden="true"></i>
                    </span>
                    <span>@(this.queryResult.LineDesignation)</span>
                </a>
            </li>
        }
    </ul>
</nav>
<section class="section">
    <h1 class="title">Lina</h1>
    @if (this.queryResult != null)
    {
        <p class="subtitle">@(this.queryResult.LineDesignation)</p>
    }
</section>
<hr/>
@if (this.queryResult == null)
{
    <EditForm EditContext="this.formContext" OnValidSubmit="this.Submit" FormName="GetQueryForm">
        <FluentValidationValidator @ref="this.validator" TModel="GetLineQuery"/>
        <section class="section">
            <div class="field">
                <label class="label">ID</label>
                <TemplatedValidationMessage For="() => this.query.LineId" BaseClass="input">
                    <InputTemplate Context="inputClasses">
                        <input class="@(inputClasses)" value="@(this.query.LineId)" disabled/>
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
        </section>
    </EditForm>
}
else
{
    <section class="section">
        <div class="table-container">
            <table class="table is-fullwidth">
                <thead>
                <tr>
                    <th>Numer</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in this.queryResult.Trips)
                {
                    <tr>
                        <td><a href="trip/@(item.TripId)">@(item.TripNumber)</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private GetLineQuery query;
    private EditContext formContext;
    private FluentValidationValidator<GetLineQuery> validator;

    private GetLineQueryResult? queryResult = null;

    [Parameter]
    public Guid LineId { get; set; }

    protected override Task OnInitializedAsync()
    {
        this.query = new GetLineQuery();
        this.formContext = new EditContext(this.query);
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        this.query.LineId = this.LineId;
        await this.Submit();
    }

    private async Task Submit()
    {
        var valid = this.formContext.Validate();
        if (valid)
        {
            try
            {
                this.queryResult = await this.Mediator.Send(this.query);
            }
            catch (ValidationException exception)
            {
                this.validator.PopulateErrors(exception.Errors);
            }
        }
    }
}