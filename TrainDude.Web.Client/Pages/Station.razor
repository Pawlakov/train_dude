@page "/station/{StationId:guid}"
@using FluentValidation
@using Mediator
@using TrainDude.Queries.Requests.GetStationQuery
@using TrainDude.Web.Client.Validation
@inject ISender Mediator

@if (this.queryResult != null)
{
    <PageTitle>Stacja @(this.queryResult.Name)</PageTitle>
}
else
{
    <PageTitle>Stacja</PageTitle>
}

<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li>
            <a href="/">
                <span class="icon is-small">
                    <i class="fas fa-map" aria-hidden="true"></i>
                </span>
                <span>Mapa</span>
            </a>
        </li>
        <li>
            <a href="/stations">
                <span class="icon is-small">
                    <i class="fas fa-list" aria-hidden="true"></i>
                </span>
                <span>Stacje</span>
            </a>
        </li>
        @if (this.queryResult != null)
        {
            <li class="is-active">
                <a href="/station/@(this.StationId)">
                    <span class="icon is-small">
                        <i class="fas fa-shop" aria-hidden="true"></i>
                    </span>
                    <span>@(this.queryResult.Name)</span>
                </a>
            </li>
        }
    </ul>
</nav>
<section class="section">
    <h1 class="title">Stacja</h1>
    @if (this.queryResult != null)
    {
        <p class="subtitle">@(this.queryResult.Name)</p>
    }
</section>
<hr/>
@if (this.queryResult == null)
{
    <EditForm EditContext="this.formContext" OnValidSubmit="this.Submit" FormName="GetStationForm">
        <FluentValidationValidator @ref="this.validator" TModel="GetStationQuery"/>
        <section class="section">
            <div class="field">
                <label class="label">ID</label>
                <TemplatedValidationMessage For="() => this.query.StationId" BaseClass="input">
                    <InputTemplate Context="inputClasses">
                        <input class="@(inputClasses)" value="@(this.query.StationId)" disabled/>
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
        </section>
    </EditForm>
}
else
{
    <section class="section">
        
    </section>
}

@code {
    private GetStationQuery query;
    private EditContext formContext;
    private FluentValidationValidator<GetStationQuery> validator;

    private GetStationQueryResult? queryResult = null;

    [Parameter]
    public Guid StationId { get; set; }

    protected override Task OnInitializedAsync()
    {
        this.query = new GetStationQuery();
        this.formContext = new EditContext(this.query);
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        this.query.StationId = this.StationId;
        await this.Submit();
    }

    private async Task Submit()
    {
        var valid = this.formContext.Validate();
        if (valid)
        {
            try
            {
                this.queryResult = await this.Mediator.Send(this.query);
            }
            catch (ValidationException exception)
            {
                this.validator.PopulateErrors(exception.Errors);
            }
        }
    }
}