@page "/admin"
@using TrainDude.Application.Requests.DropAndSeedCommand
@using TrainDude.Web.Client.Layout
@layout BlockMapLayout

@inject IMediator mediator

<PageTitle>Administracja</PageTitle>

<header class="modal-card-head">
    <p class="card-header-title title">Administracja</p>
</header>
<section class="modal-card-body">
    <div class="block">
        <h2 class="title">Stacje i odcinki</h2>
        <div class="buttons">
            <button class="button is-info @(this.loadingActive ? "is-loading" : "")" onclick="@this.DropAndSeed">
                Drop & Seed
            </button>
        </div>
    </div>
</section>

@code {
    private bool loadingActive;

    private async Task DropAndSeed()
    {
        this.loadingActive = true;
        this.StateHasChanged();
        
        await this.mediator.Send(new DropAndSeedCommand());

        this.loadingActive = false;
        this.StateHasChanged();
    }
}