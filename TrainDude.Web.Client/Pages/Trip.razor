@page "/trip/{TripId:guid}"
@using FluentValidation
@using Mediator
@using TrainDude.Queries.Requests.GetTripQuery
@using TrainDude.Web.Client.Validation
@inject ISender Mediator

@if (this.queryResult != null)
{
    <PageTitle>Kurs @(this.queryResult.TripNumber)</PageTitle>
}
else
{
    <PageTitle>Kurs</PageTitle>
}

<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li>
            <a href="/">
                <span class="icon is-small">
                    <i class="fas fa-map" aria-hidden="true"></i>
                </span>
                <span>Mapa</span>
            </a>
        </li>
        <li>
            <a href="/trips">
                <span class="icon is-small">
                    <i class="fas fa-list" aria-hidden="true"></i>
                </span>
                <span>Kursy</span>
            </a>
        </li>
        @if (this.queryResult != null)
        {
            <li class="is-active">
                <a href="/trip/@(this.TripId)">
                    <span class="icon is-small">
                        <i class="fas fa-train" aria-hidden="true"></i>
                    </span>
                    <span>@(this.queryResult.TripNumber)</span>
                </a>
            </li>
        }
    </ul>
</nav>
<section class="section">
    <h1 class="title">Kurs</h1>
    @if (this.queryResult != null)
    {
        <p class="subtitle">@(this.queryResult.TripNumber)</p>
    }
</section>
<hr/>
@if (queryResult == null && this.query.TripId != Guid.Empty)
{
    <EditForm EditContext="this.formContext" OnValidSubmit="this.Submit" FormName="GetTripForm">
        <FluentValidationValidator @ref="this.validator" TModel="GetTripQuery"/>
        <section class="section">
            <div class="field">
                <label class="label">ID</label>
                <TemplatedValidationMessage For="() => this.query.TripId" BaseClass="input">
                    <InputTemplate Context="inputClasses">
                        <input class="@(inputClasses)" value="@(this.query.TripId)" disabled/>
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
        </section>
    </EditForm>
}
else
{
    <section class="section">
        
    </section>
}

@code {
    private GetTripQuery query;
    private EditContext formContext;
    private FluentValidationValidator<GetTripQuery> validator;

    private GetTripQueryResult? queryResult = null;

    [Parameter]
    public Guid TripId { get; set; }

    protected override Task OnInitializedAsync()
    {
        this.query = new GetTripQuery();
        this.formContext = new EditContext(this.query);
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        this.query.TripId = this.TripId;
        await this.Submit();
    }

    private async Task Submit()
    {
        var valid = this.formContext.Validate();
        if (valid)
        {
            try
            {
                this.queryResult = await this.Mediator.Send(this.query);
            }
            catch (ValidationException exception)
            {
                this.validator.PopulateErrors(exception.Errors);
            }
        }
    }
}