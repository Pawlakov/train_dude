@using System.Globalization
@using Mediator
@using TrainDude.Application.Requests.GetSegmentGeoJsonQuery
@using TrainDude.Application.Requests.GetSegmentQuery

@page "/segment/{Id:int}"

@inject NavigationManager NavigationManager
@inject IMediator Mediator
@inject IJSRuntime JS

<PageTitle>Odcinek</PageTitle>

<section class="section">
    <h1 class="title">Odcinek</h1>
    @if (this.segment != null)
    {
        <p class="subtitle">@(this.segment.AName) - @(this.segment.BName)</p>
    }
</section>

@code {
    private IJSObjectReference scriptModule;
    private GetSegmentQueryResult? segment;
    private string? geoJson;
    private bool dataPresnt;
    private bool loadingActive;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        this.loadingActive = true;
        this.StateHasChanged();
        
        this.segment = await this.Mediator.Send(new GetSegmentQuery { SegmentId = this.Id });
        if (this.segment != null)
        {
            var result = await this.Mediator.Send(new GetSegmentGeoDataQuery { SegmentId = this.Id });
            this.geoJson = this.BuildGeoJson(result);
        }
        else
        {
            this.loadingActive = false;
            this.StateHasChanged();
            
            this.NavigationManager.NavigateTo("/not-found");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.scriptModule = await this.JS.InvokeAsync<IJSObjectReference>("import", "./Layout/BaseMapLayout.razor.js");
        }
        
        if (!dataPresnt && this.geoJson != null)
        {
            await this.scriptModule.InvokeVoidAsync("clearGeoJson");
            await this.scriptModule.InvokeVoidAsync("addGeoJson", this.geoJson);

            this.dataPresnt = true;
            this.loadingActive = false;
            this.StateHasChanged();
        }
    }

    private string BuildGeoJson(GetSegmentGeoDataQueryResult data)
    {
        var stationsGeoJson = new List<string>();
        var segmentsGeoJson = new List<string>();

        foreach (var station in data.Stations)
        {
            stationsGeoJson.Add($"{{ \"type\": \"Point\", \"coordinates\": [{station.Longitude.ToString(CultureInfo.InvariantCulture)},{station.Latitude.ToString(CultureInfo.InvariantCulture)}] }}");
        }
        
        var points = data.Segment.Vertices.Prepend(data.Segment.ALocation!).Append(data.Segment.BLocation!);

        var line = string.Join(',', points.Select(x => $"[{x.Longitude.ToString(CultureInfo.InvariantCulture)},{x.Latitude.ToString(CultureInfo.InvariantCulture)}]"));

        segmentsGeoJson.Add($"{{ \"type\": \"LineString\", \"coordinates\": [{line}] }}");

        return $"[{string.Join(',', segmentsGeoJson.Concat(stationsGeoJson))}]";
    }
}
