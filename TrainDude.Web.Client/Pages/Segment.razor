@using TrainDude.Application.Requests.GetSegmentGeoJsonQuery
@using TrainDude.Application.Requests.GetSegmentQuery

@page "/segment/{Id:int}"

@inject NavigationManager NavigationManager
@inject IMediator Mediator
@inject IJSRuntime JS

<PageTitle>Odcinek</PageTitle>

<section class="section">
    <h1 class="title">Odcinek</h1>
    @if (this.segment != null)
    {
        <p class="subtitle">@(this.segment.AName) - @(this.segment.BName)</p>
    }
</section>

@code {
    private IJSObjectReference scriptModule;
    private GetSegmentQueryResult? segment;
    private string? segmentGeoJson;
    private bool dataPresnt;
    private bool loadingActive;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        this.loadingActive = true;
        this.StateHasChanged();
        
        this.segment = await this.Mediator.Send(new GetSegmentQuery { SegmentId = this.Id });
        if (this.segment != null)
        {
            var result = await this.Mediator.Send(new GetSegmentGeoJsonQuery { SegmentId = this.Id });
            this.segmentGeoJson = result.GeoJson;
        }
        else
        {
            this.loadingActive = false;
            this.StateHasChanged();
            
            this.NavigationManager.NavigateTo("/not-found");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.scriptModule = await this.JS.InvokeAsync<IJSObjectReference>("import", "./Layout/BaseMapLayout.razor.js");
        }
        
        if (!dataPresnt && this.segmentGeoJson != null)
        {
            await this.scriptModule.InvokeVoidAsync("clearGeoJson");
            await this.scriptModule.InvokeVoidAsync("addGeoJson", this.segmentGeoJson);

            this.dataPresnt = true;
            this.loadingActive = false;
            this.StateHasChanged();
        }
    }
}
