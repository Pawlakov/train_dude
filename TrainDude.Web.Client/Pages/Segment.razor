@using System.Globalization
@using Mediator
@using TrainDude.Queries.Requests.GetSegmentQuery

@page "/segment/{Id:int}"

@inject NavigationManager NavigationManager
@inject ISender Mediator
@inject IJSRuntime JS

<PageTitle>Odcinek</PageTitle>

<section class="section">
    <h1 class="title">Odcinek</h1>
    @if (this.segment != null)
    {
        <p class="subtitle">@(this.segment.AName) - @(this.segment.BName)</p>
    }
</section>

@code {
    private IJSObjectReference scriptModule;
    private GetSegmentQueryResult? segment;
    private string? geoJson;
    private bool dataPresent;
    private bool loadingActive;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        this.loadingActive = true;
        this.StateHasChanged();

        this.segment = await this.Mediator.Send(new GetSegmentQuery { SegmentId = this.Id });
        if (this.segment != null)
        {
            this.geoJson = this.BuildGeoJson(this.segment);
        }
        else
        {
            this.loadingActive = false;
            this.StateHasChanged();

            this.NavigationManager.NavigateTo("/not-found");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.scriptModule = await this.JS.InvokeAsync<IJSObjectReference>("import", "./Layout/BaseMapLayout.razor.js");
        }

        if (!dataPresent && this.geoJson != null)
        {
            await this.scriptModule.InvokeVoidAsync("clearGeoJson");
            await this.scriptModule.InvokeVoidAsync("addGeoJson", this.geoJson);

            this.dataPresent = true;
            this.loadingActive = false;
            this.StateHasChanged();
        }
    }

    private string BuildGeoJson(GetSegmentQueryResult data)
    {
        var stationsGeoJson = new List<string>();
        var segmentsGeoJson = new List<string>();

        if (data.ALocation.HasValue)
        {
            stationsGeoJson.Add($"{{ \"type\": \"Point\", \"coordinates\": [{data.ALocation.Value.Longitude.ToString(CultureInfo.InvariantCulture)},{data.ALocation.Value.Latitude.ToString(CultureInfo.InvariantCulture)}] }}");
        }

        if (data.BLocation.HasValue)
        {
            stationsGeoJson.Add($"{{ \"type\": \"Point\", \"coordinates\": [{data.BLocation.Value.Longitude.ToString(CultureInfo.InvariantCulture)},{data.BLocation.Value.Latitude.ToString(CultureInfo.InvariantCulture)}] }}");
        }

        var line = string.Join(',', data.Vertices.Select(x => $"[{x.Longitude.ToString(CultureInfo.InvariantCulture)},{x.Latitude.ToString(CultureInfo.InvariantCulture)}]"));

        segmentsGeoJson.Add($"{{ \"type\": \"LineString\", \"coordinates\": [{line}] }}");

        return $"[{string.Join(',', segmentsGeoJson.Concat(stationsGeoJson))}]";
    }

}