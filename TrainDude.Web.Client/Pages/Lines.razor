@page "/lines"
@using Mediator
@using TrainDude.Queries.Requests.GetLinesQuery

@inject ISender mediator

<PageTitle>Linie</PageTitle>

<section class="section">
    <h1 class="title">Linie</h1>
    <p class="subtitle">Lista linii na które podzielony jest rozkład jazdy.</p>
</section>
<hr/>
<section class="section">
    <div class="table-container">
        <table class="table">
            <thead>
            <tr>
                <th>Symbol</th>
            </tr>
            </thead>
            <tbody>
            @if (this.items == null)
            {
                <tr>
                    <td colspan="2"><em>Ładowanie...</em></td>
                </tr>
            }
            else
            {
                @foreach (var item in items)
                {
                    <tr>
                        <td>@(item.LineDesignation)</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    private IEnumerable<GetLinesQueryResultItem>? items;

    protected override async Task OnParametersSetAsync()
    {
        var result = await this.mediator.Send(new GetLinesQuery());
        this.items = result.Items.ToList();
    }

}