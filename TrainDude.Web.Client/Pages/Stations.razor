@using Mediator
@using TrainDude.Queries.Requests.GetStationsQuery

@page "/stations"

@inject ISender mediator

<PageTitle>Stacje</PageTitle>

<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li>
            <a href="/">
                <span class="icon is-small">
                    <i class="fas fa-map" aria-hidden="true"></i>
                </span>
                <span>Mapa</span>
            </a>
        </li>
        <li class="is-active">
            <a href="/stations">
                <span class="icon is-small">
                    <i class="fas fa-list" aria-hidden="true"></i>
                </span>
                <span>Stacje</span>
            </a>
        </li>
    </ul>
</nav>
<section class="section">
    <h1 class="title">Stacje</h1>
    <p class="subtitle">Lista stacji.</p>
</section>
<hr />
<section class="section">
    <div class="table-container">
        <table class="table is-fullwidth">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Położenie</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (this.items == null)
                {
                    <tr>
                        <td colspan="3"><em>Ładowanie...</em></td>
                    </tr>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@(item.Name)</td>
                            <td>@(item.HasLocation)</td>
                            <td><a href="station/@(item.StationId)">Szczegóły</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private IEnumerable<GetStationsQueryResultItem>? items;

    protected override async Task OnParametersSetAsync()
    {
        var result = await this.mediator.Send(new GetStationsQuery());
        this.items = result.Items.ToList();
    }
}