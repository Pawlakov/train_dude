@using Mediator
@using TrainDude.Queries.Requests.GetStationsQuery

@page "/stations"

@inject ISender mediator

<PageTitle>Stacje</PageTitle>

<section class="section">
    <h1 class="title">Stacje</h1>
    <p class="subtitle">Lista stacji.</p>
</section>
<hr />
<section class="section">
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Położenie</th>
                </tr>
            </thead>
            <tbody>
                @if (this.items == null)
                {
                    <tr>
                        <td colspan="2"><em>Ładowanie...</em></td>
                    </tr>
                }
                else
                {
                    @foreach (var station in items)
                    {
                        <tr>
                            <td>@(station.Name)</td>
                            <td>@(station.HasLocation)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private IEnumerable<GetStationsQueryResultItem>? items;

    protected override async Task OnParametersSetAsync()
    {
        var result = await this.mediator.Send(new GetStationsQuery());
        this.items = result.Items.ToList();
    }
}