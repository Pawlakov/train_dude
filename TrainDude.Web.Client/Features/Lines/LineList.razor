@page "/lines"
@using Mediator
@using TrainDude.Queries.Requests.Lines
@inherits EntityListPageBase<GetLinesQuery, GetLinesQueryResult, GetLinesQueryResultItem>
@layout BlockMapLayout

@inject ISender Mediator

<PageTitle>Linie</PageTitle>

<Breadcrumb>
    <BreadcrumbItem Active="true" IconClass="list" Label="Linie" Href="/lines"/>
</Breadcrumb>
<section class="section">
    <h1 class="title">Linie</h1>
    <p class="subtitle">Lista linii na które podzielony jest rozkład jazdy.</p>
</section>
<hr/>
<section class="section">
    <div class="table-container">
        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>Symbol</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (this.items == null)
            {
                <tr>
                    <td colspan="2"><em>Ładowanie...</em></td>
                </tr>
            }
            else
            {
                @foreach (var item in this.items)
                {
                    <tr>
                        <td>@(item.LineDesignation)</td>
                        <td><a href="line/@(item.LineId)">Szczegóły</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>