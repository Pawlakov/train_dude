@page "/segments"
@using TrainDude.Queries.Contracts.Segments
@inherits EntityListPageBase<GetSegmentsQuery, GetSegmentsQueryResult, GetSegmentsQueryResultItem>
@layout BlockMapLayout

<PageTitle>Odcinki</PageTitle>

<Breadcrumb>
    <BreadcrumbItem Active="true" IconClass="list" Label="Odcinki" Href="/segments"/>
</Breadcrumb>
<section class="section">
    <h1 class="title">Odcinki</h1>
    <p class="subtitle">Lista odcinków.</p>
</section>
<hr />
<section class="section">
    <div class="table-container">
        <table class="table is-fullwidth">
            <thead>
                <tr>
                    <th>A</th>
                    <th>B</th>
                    <th>Długość</th>
                    <th>Długość nominalna</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (this.items == null)
                {
                    <tr>
                        <td colspan="5"><em>Ładowanie...</em></td>
                    </tr>
                }
                else
                {
                    @foreach (var segment in this.items)
                    {
                        <tr>
                            <td>@(segment.AName)</td>
                            <td>@(segment.BName)</td>
                            <td>
                                @if (segment.Haversine != null)
                                {
                                    <text>@($"{segment.Haversine:0.00} km")</text>
                                }
                            </td>
                            <td>
                                @if (segment.Length != null)
                                {
                                    <text>@($"{segment.Length:0.00} km")</text>
                                }
                            </td>
                            <td><a href="segment/@(segment.SegmentId)">Szczegóły</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>