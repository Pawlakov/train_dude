@using Mediator
@using TrainDude.Queries.Requests.Radii
@inherits EntityListPageBase<GetRadiiQuery, GetRadiiQueryResult, GetRadiiQueryResultItem>

@page "/radii"

<PageTitle>Promienie</PageTitle>

<Breadcrumb/>
<section class="section">
    <h1 class="title">Promienie</h1>
    <p class="subtitle">Lista minimalnych promieni łuku.</p>
</section>
<hr/>
<section class="section">
    <div class="table-container">
        <table class="table">
            <thead>
            <tr>
                <th>Prędkość maksymalna</th>
                <th>Minimalny promień łuku</th>
                <th>Maksymalny antypromień łuku</th>
            </tr>
            </thead>
            <tbody>
            @if (this.items == null)
            {
                <tr>
                    <td colspan="3"><em>Loading...</em></td>
                </tr>
            }
            else
            {
                @foreach (var radius in this.items)
                {
                    <tr>
                        <td>@($"{radius.Speed}") km/h</td>
                        <td>@($"{radius.Minimum}") km</td>
                        <td>@($"{radius.MaximumAntiradius:0.00}") 1/Mm</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>