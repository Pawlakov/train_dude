@page "/trips"
@using Mediator
@using TrainDude.Queries.Requests.Trips
@inherits EntityListPageBase<GetTripsQuery, GetTripsQueryResult, GetTripsQueryResultItem>
@layout BlockMapLayout

@inject ISender Mediator

<PageTitle>Kursy</PageTitle>

<Breadcrumb />
<section class="section">
    <h1 class="title">Kursy</h1>
    <p class="subtitle">Lista kursów w rozkładzie jazdy.</p>
</section>
<hr/>
<section class="section">
    <div class="table-container">
        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>Numer</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (this.items == null)
            {
                <tr>
                    <td colspan="2"><em>Ładowanie...</em></td>
                </tr>
            }
            else
            {
                @foreach (var item in this.items)
                {
                    <tr>
                        <td>@(item.TripNumber)</td>
                        <td><a href="trip/@(item.TripId)">Szczegóły</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>